{
  "name": "shadow-pet",
  "productName": "Shadow",
  "version": "1.0.0",
  "description": "Shadow - an Avengers pixel-art desktop team with the original panther theme available.",
  "author": "Prince",
  "license": "UNLICENSED",
  "private": true,
  "main": "main/main.js",
  "scripts": {
    "start": "electron .",
    "sprites": "node scripts/generate-sprites.js && node scripts/generate-friends.js && node scripts/generate-avengers.js",
    "sprites:avengers": "node scripts/generate-avengers.js",
    "fonts": "node scripts/copy-fonts.js",
    "test": "electron . --self-test",
    "test:whatsapp": "node --test tests/whatsapp.test.js tests/whatsweb.test.js",
    "prebuild": "node scripts/generate-sprites.js && node scripts/generate-friends.js && node scripts/generate-avengers.js",
    "build": "electron-builder --win nsis"
  },
  "build": {
    "appId": "com.prince.shadowpet",
    "productName": "Shadow",
    "copyright": "Shadow desktop pet",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "main/**/*",
      "renderer/**/*",
      "assets/**/*",
      "package.json",
      "!assets/preview/**"
    ],
    "asarUnpack": ["main/windows/**"],
    "extraResources": [
      {
        "from": "config",
        "to": "config"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/themes/avengers/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Shadow",
      "installerIcon": "assets/themes/avengers/icon.ico",
      "uninstallerIcon": "assets/themes/avengers/icon.ico",
      "installerHeaderIcon": "assets/themes/avengers/icon.ico",
      "artifactName": "Shadow-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Prince290310",
        "repo": "my-pet",
        "releaseType": "release"
      }
    ]
  },
  "devDependencies": {
    "@fontsource/pixelify-sans": "^5.3.0",
    "@fontsource/press-start-2p": "^5.3.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "qrcode": "^1.5.4",
    "whatsapp-web.js": "^1.34.7"
  }
}
