{
  "name": "shadow-pet",
  "productName": "Shadow",
  "version": "1.0.0",
  "description": "Shadow - an original pixel-art black panther desktop pet (Phase 1, fully offline).",
  "author": "Prince",
  "license": "UNLICENSED",
  "private": true,
  "main": "main/main.js",
  "scripts": {
    "start": "electron .",
    "sprites": "node scripts/generate-sprites.js",
    "fonts": "node scripts/copy-fonts.js",
    "test": "electron . --self-test",
    "prebuild": "node scripts/generate-sprites.js",
    "build": "electron-builder --win nsis"
  },
  "build": {
    "appId": "com.prince.shadowpet",
    "productName": "Shadow",
    "copyright": "Shadow desktop pet",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "main/**/*",
      "renderer/**/*",
      "assets/**/*",
      "package.json",
      "!assets/preview/**"
    ],
    "extraResources": [
      {
        "from": "config",
        "to": "config"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Shadow",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "artifactName": "Shadow-Setup-${version}.${ext}"
    }
  },
  "devDependencies": {
    "@fontsource/pixelify-sans": "^5.3.0",
    "@fontsource/press-start-2p": "^5.3.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  }
}
